<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Add requiredAnalyzed only if the node is missing (compatible with other mods). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="MicroelectronicsBasics"]/requiredAnalyzed</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ResearchProjectDef[defName="MicroelectronicsBasics"]/requiredAnalyzed</xpath>
      <value>
        <li>Microelectronics_Chip</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ResearchProjectDef[defName="MicroelectronicsBasics"]</xpath>
      <value>
        <requiredAnalyzed>
          <li>Microelectronics_Chip</li>
        </requiredAnalyzed>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="MicroelectronicsBasics"]/baseCost</xpath>
    <value><baseCost>800</baseCost></value>
  </Operation>
</Patch>
